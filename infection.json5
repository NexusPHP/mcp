{
    "$schema": "./tools/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Client/Transport/AmpSubprocess.php",
            "Client/Transport/AmpSubprocessLauncher.php"
        ]
    },
    "timeout": 30,
    "threads": "max",
    "dotsPerRow": "max",
    "logs": {
        "text": "build/logs/infection/infection.log",
        "html": "build/logs/infection/infection.html",
        "stryker": {
            "report": "1.x"
        }
    },
    "tmpDir": "build",
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true,
        "FunctionCallRemoval": {
            "ignore": [
                "Nexus\\Mcp\\Core\\Dispatch\\PendingCoroutines::flushPending"
            ]
        },
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                ".*followRedirects\\(0\\).*"
            ]
        },
        "MethodCallRemoval": {
            "ignore": [
                "Nexus\\Mcp\\Core\\Dispatch\\PendingCoroutines::track",
                "Nexus\\Mcp\\Client\\Auth\\AuthorizationCoordinator::runExclusively"
            ],
            "ignoreSourceCodeByRegex": [
                "SuggestedDependencyGuard::verify\\(.*",
                "SuggestedDependencyGuard::verifyExtension\\(.*"
            ]
        }
    },
    "testFramework": "phpunit"
}
