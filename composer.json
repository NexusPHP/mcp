{
    "name": "nexusphp/mcp-sdk",
    "description": "PHP SDK for the MCP specification",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "mcp",
        "model context protocol",
        "mcp-sdk"
    ],
    "authors": [
        {
            "name": "John Paul E. Balandan, CPA",
            "email": "paulbalandan@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/NexusPHP/mcp-sdk/issues",
        "source": "https://github.com/NexusPHP/mcp-sdk.git"
    },
    "require": {
        "php": "^8.4",
        "nexusphp/assert": "^1.1"
    },
    "require-dev": {
        "nexusphp/tachycardia": "^2.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "replace": {
        "nexusphp/mcp-client-sdk": "self.version",
        "nexusphp/mcp-core-sdk": "self.version",
        "nexusphp/mcp-server-sdk": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nexus\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Mcp\\Tests\\": "tests/",
            "Nexus\\Mcp\\Tools\\": "tools/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-update-cmd": [
            "Nexus\\Mcp\\Tools\\ComposerScripts::postUpdate"
        ],
        "post-autoload-dump": [
            "@composer update --ansi --working-dir=tools"
        ],
        "cs:check": "tools/vendor/bin/php-cs-fixer check --ansi --verbose --diff",
        "cs:fix": "tools/vendor/bin/php-cs-fixer fix --ansi --verbose --diff",
        "mutation:check": [
            "Composer\\Config::disableProcessTimeout",
            "tools/vendor/bin/infection --ansi --with-uncovered --static-analysis-tool=phpstan"
        ],
        "mutation:filter": "@mutation:check --git-diff-filter=AM --git-diff-base=origin/1.x",
        "phpstan:baseline": "phpstan analyse --ansi --verbose --generate-baseline=phpstan-baseline.php",
        "phpstan:check": "phpstan analyse --ansi --verbose",
        "schema:generate": "tools/generate-schema",
        "spec:snapshot-anchors": "tools/snapshot-spec-anchors",
        "test:all": [
            "@cs:check",
            "@phpstan:check",
            "@test:auto-review",
            "@test:stan",
            "@test:unit",
            "@mutation:check"
        ],
        "test:auto-review": "phpunit --group=auto-review --colors=always --no-coverage",
        "test:client": "phpunit --group=client-tests --colors=always --coverage-html=build/phpunit/html",
        "test:core": "phpunit --group=core-tests --colors=always --coverage-html=build/phpunit/html",
        "test:server": "phpunit --group=server-tests --colors=always --coverage-html=build/phpunit/html",
        "test:stan": "phpunit --group=static-analysis --colors=always --no-coverage",
        "test:unit": "phpunit --group=unit-tests --colors=always --coverage-html=build/phpunit/html"
    },
    "scripts-descriptions": {
        "cs:check": "Checks for coding style violations",
        "cs:fix": "Fixes any coding style violations",
        "mutation:check": "Runs Infection on whole codebase",
        "mutation:filter": "Runs Infection on added and modified files only",
        "phpstan:baseline": "Runs PHPStan and dumps resulting errors to baseline",
        "phpstan:check": "Runs PHPStan",
        "schema:generate": "Generates latest-schema.json and sorted-schema.json files",
        "spec:snapshot-anchors": "Snapshots heading anchor IDs from MCP spec docs pages for @see verification",
        "test:all": "Runs all tests (coding style, static analysis, automatic code review, type inference, and unit tests)",
        "test:auto-review": "Runs the automatic code review tests",
        "test:client": "Runs the Client component tests with code coverage",
        "test:core": "Runs the Core component tests with code coverage",
        "test:server": "Runs the Server component tests with code coverage",
        "test:stan": "Runs the static-analysis (PHPStan type-inference lock-in) tests",
        "test:unit": "Runs the unit tests with code coverage"
    }
}
