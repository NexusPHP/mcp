# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{neon,yml,json}]
indent_size = 2

# AutoReview JSON fixtures (data/, envelope-shapes/, schema-payload/) are
# compared byte-for-byte against `json_encode(..., JSON_PRETTY_PRINT)`, which
# PHP hardcodes to 4-space indent.
[tests/AutoReview/**.json]
indent_size = 4
