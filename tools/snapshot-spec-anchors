use Nexus\Mcp\Tools\McpAnchorSnapshot;

if (! is_file(__DIR__.'/../composer.json')) {
    throw new RuntimeException('Could not determine repository root. Are you running from the repository directory?');
}

if (is_file(__DIR__.'/../vendor/autoload.php')) {
    require __DIR__.'/../vendor/autoload.php';
} elseif (is_file(__DIR__.'/../tools/vendor/autoload.php')) {
    require __DIR__.'/../tools/vendor/autoload.php';
}

try {
    echo "\033[36mGenerating spec anchor snapshot...\033[0m\n\n";

    $snapshot = McpAnchorSnapshot::fetchAndSaveAnchorSnapshot();

    foreach ($snapshot as $url => $anchors) {
        printf("\033[32m✓\033[0m %s (\033[33m%d\033[0m anchors)\n", $url, count($anchors));
    }

    printf("\n\033[32m✓\033[0m Saved snapshot to %s\n", realpath(McpAnchorSnapshot::SNAPSHOT_PATH));

    exit(0);
} catch (Throwable $e) {
    printf("\n\033[31m✗ Error:\033[0m %s\n", $e->getMessage());

    exit(1);
}
