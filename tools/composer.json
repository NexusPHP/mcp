{
    "type": "project",
    "require": {
        "php": "^8.4",
        "boundwize/structarmed": "^0.9.1",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.33.1",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "nexusphp/cs-config": "^3.28",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/console": "8.0.*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nexus\\Mcp\\Tools\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "optimize-autoloader": true,
        "prefer-stable": true,
        "sort-packages": true
    }
}
