{
    "type": "project",
    "require": {
        "php": "^8.3",
        "boundwize/structarmed": "^0.15.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.34.2",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "nexusphp/cs-config": "^3.28",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Mcp\\Tools\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
